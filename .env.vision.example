# Leave model path unset by default: local inference reports UNAVAILABLE safely.
VISION_MODEL_PATH=
VISION_MODEL_NAME=local-onnx-person-detector
VISION_MODEL_LICENSE_REVIEWED=false
VISION_MODEL_SHA256=
VISION_CONFIDENCE_THRESHOLD=0.45
VISION_NMS_THRESHOLD=0.45

# Service safety and retention settings
VISION_MAX_FRAME_BYTES=2000000
VISION_MAX_FRAME_WIDTH=1920
VISION_MAX_FRAME_HEIGHT=1080
VISION_MAX_FRAME_AGE_MS=4000
VISION_SMOOTHING_WINDOW=5
VISION_MIN_MEAN_LUMINANCE=8
VISION_MIN_LUMINANCE_STDDEV=1.5
VISION_EVIDENCE_PERSIST_INTERVAL_SECONDS=5
