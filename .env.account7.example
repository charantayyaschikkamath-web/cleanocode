# Optional OpenAI-compatible provider; leave blank for deterministic TEMPLATE mode.
COPILOT_API_BASE_URL=
COPILOT_API_KEY=
COPILOT_MODEL=
COPILOT_TIMEOUT_SECONDS=8
COPILOT_MAX_CONTEXT_RECORDS=40

# Keep these paths local to the backend process; do not commit generated reports/cache.
COPILOT_CACHE_PATH=data/copilot_report_cache.json
COPILOT_REPORTS_DIR=data/reports

# Automatic what-if baseline requires a recent wall-clock power reading.
WHAT_IF_MAX_READING_AGE_SECONDS=900

# Vite only: blank uses same-origin requests.
VITE_API_BASE_URL=
