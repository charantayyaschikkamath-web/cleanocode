# Copy to .env. Never commit a real API key or password.
CAMPUS_TWIN_ENVIRONMENT=development
CAMPUS_TWIN_DATABASE_URL=sqlite:///./data/campustwin.db
CAMPUS_TWIN_API_PREFIX=/api/v1
CAMPUS_TWIN_LOG_LEVEL=INFO
CAMPUS_TWIN_VIRTUAL_TIME_MULTIPLIER=30
CAMPUS_TWIN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Leave blank unless the factors are sourced and documented.
CAMPUS_TWIN_TARIFF_PER_KWH=
CAMPUS_TWIN_CO2_FACTOR_KG_PER_KWH=
CAMPUS_TWIN_IMPACT_CALCULATION_VERSION=energy-impact-v1

# Optional custom YAML configuration path.
# CAMPUS_TWIN_CONFIG_FILE=./config.yaml

# Optional Account 7 Copilot provider; keep credentials server-side, never in VITE_* variables.
COPILOT_API_BASE_URL=
COPILOT_API_KEY=
COPILOT_MODEL=
COPILOT_TIMEOUT_SECONDS=12

# Optional local vision model. Operator must supply compatible reviewed weights; startup does not download them.
VISION_MODEL_PATH=
VISION_MODEL_LICENSE_REVIEWED=false
VISION_MODEL_SHA256=
